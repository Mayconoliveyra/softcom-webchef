# Identificação da aplicação.
APP_NAME="Softcom WebChef"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Portas acessadas no computador para a aplicação em desenvolvimento, a versão buildada e o phpMyAdmin.
APP_PORT=18080
APP_BUILD_PORT=18081
PMA_PORT=18082

# Canal usado para registrar mensagens e erros da aplicação.
LOG_CHANNEL=stack

# Dados usados pelo Laravel para conectar ao MySQL.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=softcom_webchef
DB_USERNAME=webchef
DB_PASSWORD=webchef

# Senha do usuário administrador do MySQL. A aplicação não usa este usuário.
MYSQL_ROOT_PASSWORD=webchef_root_local

# Cache e sessões armazenados em arquivos locais.
CACHE_DRIVER=file
SESSION_DRIVER=file
# Tempo de duração da sessão de login, em minutos.
SESSION_LIFETIME=120

# Dados usados pelo seeder para criar o primeiro usuário da aplicação.
# Defina a senha no .env antes de executar php artisan migrate --seed.
DEFAULT_USER_NAME=SOFTCOM
DEFAULT_USER_EMAIL=softcom@softcomtecnologia.com
DEFAULT_USER_PASSWORD=
